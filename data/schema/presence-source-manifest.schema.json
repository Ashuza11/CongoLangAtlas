{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://congolangatlas.org/schema/presence-source-manifest.schema.json",
  "title": "Language-presence source manifest",
  "type": "object",
  "required": ["manifest_version", "reviewed_at", "sources"],
  "properties": {
    "manifest_version": {"const": 1},
    "reviewed_at": {"$ref": "definitions.schema.json#/$defs/date"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "citation", "publisher", "version", "published_at", "landing_page", "download_url", "doi", "licence_id", "sha256"],
        "properties": {
          "id": {"$ref": "definitions.schema.json#/$defs/id"},
          "citation": {"type": "string", "minLength": 3},
          "publisher": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "published_at": {"$ref": "definitions.schema.json#/$defs/date"},
          "landing_page": {"$ref": "definitions.schema.json#/$defs/url"},
          "download_url": {"$ref": "definitions.schema.json#/$defs/url"},
          "doi": {
            "oneOf": [
              {"$ref": "definitions.schema.json#/$defs/url"},
              {"type": "null"}
            ]
          },
          "licence_id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
