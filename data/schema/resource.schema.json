{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://congolangatlas.org/schema/resource.schema.json",
  "title": "Resource",
  "type": "object",
  "required": ["entity_type", "id", "title", "resource_type", "modalities", "languages", "geographic_scope", "publisher", "retrieved_at", "homepage_url", "access_type", "licence_id", "redistribution", "source_id", "verification_status", "last_reviewed_at"],
  "properties": {
    "entity_type": {"const": "resource"},
    "id": {"$ref": "definitions.schema.json#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "resource_type": {"enum": ["dataset", "corpus", "bitext", "speech", "dictionary", "grammar", "orthography", "publication", "tool", "model", "benchmark", "other"]},
    "modalities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["text", "tabular", "audio", "image", "video", "multimodal"]}},
    "languages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["language_id", "provenance_note"],
        "properties": {"language_id": {"$ref": "definitions.schema.json#/$defs/id"}, "provenance_note": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }
    },
    "geographic_scope": {"enum": ["drc-only", "drc-labelled", "cross-border", "generic", "uncertain"]},
    "publisher": {"type": "string", "minLength": 1},
    "creators": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "version": {"type": ["string", "null"]},
    "published_at": {"type": ["string", "null"], "format": "date"},
    "retrieved_at": {"$ref": "definitions.schema.json#/$defs/date"},
    "homepage_url": {"$ref": "definitions.schema.json#/$defs/url"},
    "download_url": {"type": ["string", "null"], "format": "uri"},
    "access_type": {"enum": ["open-download", "gated", "registration", "request-only", "catalogue-only", "unavailable", "unknown"]},
    "licence_id": {"type": ["string", "null"]},
    "terms_url": {"type": ["string", "null"], "format": "uri"},
    "terms_checked_at": {"type": ["string", "null"], "format": "date"},
    "redistribution": {"enum": ["allowed", "metadata-only", "restricted", "prohibited", "unknown"]},
    "size": {"type": ["number", "null"], "minimum": 0},
    "unit": {"type": ["string", "null"]},
    "format": {"type": ["string", "null"]},
    "domain": {"type": ["string", "null"]},
    "source_id": {"$ref": "definitions.schema.json#/$defs/id"},
    "verification_status": {"$ref": "definitions.schema.json#/$defs/verificationStatus"},
    "limitations": {"type": "string"},
    "last_reviewed_at": {"$ref": "definitions.schema.json#/$defs/date"}
  },
  "additionalProperties": false
}
